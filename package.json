{
  "name": "kids-games",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Browser games Lucas builds with Claude for his kids. One folder per game in games/.",
  "workspaces": [
    "packages/*",
    "games/*"
  ],
  "scripts": {
    "new-game": "node scripts/new-game.mjs",
    "games": "node scripts/list-games.mjs",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
